{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"paths": {
			"electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
			"electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"]
		}
	},
	"include": ["src/**/*", "scripts/**/*", "*.config.ts"]
}
