{
	"extends": "./.hutch/devkit/tsconfig.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0"
	},
	"include": ["src/**/*", "scripts/**/*", "*.config.ts"]
}
