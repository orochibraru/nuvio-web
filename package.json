{
	"name": "nuvio-web",
	"private": true,
	"version": "1.0.7",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "./build/server",
		"preview": "vite preview",
		"prepare": "prek install --allow-missing-config || true; svelte-kit sync || echo ''",
		"lint": "tailwint && biome check .",
		"lint:fix": "tailwint --fix && biome check --write .",
		"format": "markdownlint-cli2 '**/*.md' && prettier --log-level warn '**/*.md'",
		"format:fix": "markdownlint-cli2 --fix '**/*.md' && prettier --log-level warn --write '**/*.md'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"nuvio:check": "bun run scripts/check-nuvio-spec.ts",
		"nuvio:check:accept": "bun run scripts/check-nuvio-spec.ts --update",
		"nuvio:spec": "bun run scripts/build-nuvio-spec.ts",
		"nuvio:spec:check": "bun run scripts/build-nuvio-spec.ts --check",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:full-suite": "bun run --parallel test:unit test:e2e",
		"release": "semantic-release",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:ui": "playwright test --ui",
		"screenshots": "playwright test --project=showcase"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.11",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.39.0",
		"@orochibraru/svelte-smol": "^1.6.0",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/kit": "^3.0.0-next.25",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"@vitest/coverage-istanbul": "4.1.11",
		"@vitest/ui": "^4.1.11",
		"axe-core": "^4.13.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"markdownlint-cli2": "^0.23.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"hls.js": "^1.7.1",
		"valibot": "^1.4.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
