{
	"name": "nuvio-web",
	"private": true,
	"version": "1.0.16",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "./build/server",
		"preview": "vite preview",
		"prepare": "prek install --allow-missing-config || true; bun run i18n || echo ''; svelte-kit sync || echo ''",
		"sync": "bun run i18n && (svelte-kit sync || echo '')",
		"lint": "prek run --all-files",
		"i18n": "paraglide-js compile --silent --project ./project.inlang --outdir ./src/lib/i18n/paraglide --strategy cookie custom-htmlLang preferredLanguage baseLocale",
		"check": "bun run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./src/service-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"nuvio:check": "bun run scripts/check-nuvio-spec.ts",
		"nuvio:check:accept": "bun run scripts/check-nuvio-spec.ts --update",
		"nuvio:spec": "bun run scripts/build-nuvio-spec.ts",
		"nuvio:spec:check": "bun run scripts/build-nuvio-spec.ts --check",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:full-suite": "bun run --parallel test:unit test:e2e",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:ui": "playwright test --ui",
		"screenshots": "playwright test --project=showcase"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.14",
		"@inlang/paraglide-js": "2.25.4",
		"@internationalized/date": "3.12.4",
		"@j178/prek": "0.5.4",
		"@lucide/svelte": "1.49.0",
		"@orochibraru/svelte-smol": "1.8.4",
		"@playwright/test": "1.63.0",
		"@sveltejs/kit": "3.0.0-next.31",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/language-server": "0.16.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.3",
		"@vitest/coverage-istanbul": "4.1.11",
		"@vitest/ui": "5.0.3",
		"axe-core": "4.13.0",
		"bits-ui": "2.19.3",
		"clsx": "2.1.1",
		"fake-indexeddb": "6.2.5",
		"markdownlint-cli2": "0.23.3",
		"mode-watcher": "1.1.0",
		"prettier": "3.9.9",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tailwint": "1.1.16",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "4.1.11"
	},
	"dependencies": {
		"@mediabunny/ac3": "1.61.0",
		"@mediabunny/dts": "1.61.0",
		"hls.js": "1.7.3",
		"mediabunny": "1.61.0",
		"valibot": "1.5.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
