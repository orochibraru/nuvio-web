{
	"name": "nuvio-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"lint": "tailwint && biome check .",
		"lint:fix": "tailwint --fix && biome check --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"nuvio:check": "bun run scripts/check-nuvio-spec.ts",
		"nuvio:check:accept": "bun run scripts/check-nuvio-spec.ts --update"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@orochibraru/svelte-smol": "^1.6.0",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"husky": "^9.1.7",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"valibot": "^1.4.2"
	}
}
