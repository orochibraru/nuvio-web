{
	"name": "nuvio-web",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky && svelte-kit sync || echo ''",
		"lint": "tailwint && biome check .",
		"lint:fix": "tailwint --fix && biome check --write .",
		"format": "markdownlint-cli2 '**/*.md' && prettier --log-level warn '**/*.md'",
		"format:fix": "markdownlint-cli2 --fix '**/*.md' && prettier --log-level warn --write '**/*.md'",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"nuvio:check": "bun run scripts/check-nuvio-spec.ts",
		"nuvio:check:accept": "bun run scripts/check-nuvio-spec.ts --update",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"release": "semantic-release",
		"test:unit:coverage": "vitest run --coverage",
		"test:e2e": "playwright test --project=chromium",
		"test:e2e:ui": "playwright test --ui",
		"screenshots": "playwright test --project=showcase"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.11",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.37.0",
		"@orochibraru/svelte-smol": "^1.6.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.0",
		"@vitest/coverage-istanbul": "4.1.11",
		"@vitest/ui": "^4.1.11",
		"axe-core": "^4.13.0",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"husky": "^9.1.7",
		"markdownlint-cli2": "^0.23.2",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.9",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"hls.js": "^1.7.1",
		"valibot": "^1.4.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
