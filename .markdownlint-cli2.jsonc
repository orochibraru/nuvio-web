{
	"config": {
		"default": true,
		"MD013": {
			"code_blocks": false,
			"headings": false,
			"line_length": 80,
			"tables": false
		},
		"MD028": false,
		// Screenshots need a width markdown syntax can't express, so `<img>` is
		// allowed; every other inline HTML element stays off.
		"MD033": {
			"allowed_elements": ["img"]
		}
	},
	"fix": true,
	"ignores": [
		"node_modules",
		"dist",
		"CHANGELOG.md",
		"test-results",
		"src/lib/nuvio/nuvio-public-api.snapshot.md",
		"TODO.md",
		".claude/**/*.md"
	]
}
