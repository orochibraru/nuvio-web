+/**
+ * @param {Request} request
+ * @param {string} host
+ * @returns {string | null}
+ */
+function browser_protocol(request, host) {
+	const value = request.headers.get('origin');
+	if (!value || !URL.canParse(value)) return null;
+	const origin = new URL(value);
+	if (!/^https?:$/.test(origin.protocol) || !URL.canParse(`${origin.protocol}//${host}`)) {
+		return null;
+	}
+	// parsed with the Origin's scheme so a default port (`Host: example.com:80`) compares equal
+	return new URL(`${origin.protocol}//${host}`).host === origin.host
+		? origin.protocol.slice(0, -1)
+		: null;
