		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{label}: {total} in the last {count} days",
				"countPlural=other": "{label}: {total} in the last {count} days"
			}
		}
	],
	"admin_chart_bar": [
		{
			"declarations": [
				"input signIns",
				"input people",
				"local signInsPlural = signIns: plural",
				"local peoplePlural = people: plural"
			],
			"selectors": ["signInsPlural", "peoplePlural"],
			"match": {
				"signInsPlural=one, peoplePlural=one": "{day}: {signIns} sign-in, {people} person",
				"signInsPlural=one, peoplePlural=other": "{day}: {signIns} sign-in, {people} people",
				"signInsPlural=other, peoplePlural=one": "{day}: {signIns} sign-ins, {people} person",
				"signInsPlural=other, peoplePlural=other": "{day}: {signIns} sign-ins, {people} people"
			}
		}
	],
