# Playwright e2e the shared test account (see e2e/auth.ts).
NUVIO_TEST_EMAIL=you@example.com
NUVIO_TEST_PASSWORD=your-password

# Server admins: the addresses allowed to reach /admin, comma separated. Unset
# means the admin page 404s for everyone. These addresses can always sign in,
# even while the instance is locked, so a bad allowlist can't lock you out.
NUVIO_ADMIN_EMAILS=you@example.com

# Where the admin database lives. Defaults to `data` relative to the working
# directory, which is /app/data in the container.
# NUVIO_DATA_DIR=data

# Key the session cookie is signed with, 32+ characters (openssl rand -hex 32).
# Unset, one is generated into <NUVIO_DATA_DIR>/session-secret on first boot and
# reused after, so keep that directory on a volume. Changing it signs everyone out.
# NUVIO_SESSION_SECRET=

# Logging. Level defaults to `debug` in dev and `info` in production; format is
# `console` (colorized, for `docker logs`) or `json` (one object per line, for a
# log shipper). An unrecognized value fails at boot rather than being ignored.
# NUVIO_LOG_LEVEL=info
# NUVIO_LOG_FORMAT=console
