# Playwright e2e — the shared test account (see e2e/auth.ts).
NUVIO_TEST_EMAIL=you@example.com
NUVIO_TEST_PASSWORD=your-password

# Optional. Raises TheIntroDB rate/usage limits for the skip-intro / outro
# lookups and folds in the key owner's pending submissions. Without it the
# public accepted community data is used. https://theintrodb.org
INTRODB_API_KEY=
